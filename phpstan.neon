includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - database/
        - tests/

    level: 5

    phpVersion: 80400

    # Model memakai `protected function casts(): array` (gaya Laravel 11+).
    parseModelCastsMethod: true
